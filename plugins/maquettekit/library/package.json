{
  "name": "@maquettekit/library",
  "version": "4.0.0",
  "private": true,
  "description": "Maquettekit Component, Effect & 3D Library — reusable recipes, the Motion Lab engine and the three-kit.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
