    "./effect-loaders": "./src/effect-loaders.ts",
    "./demo-loaders": "./src/demo-loaders.ts",
    "./motion": "./src/motion/index.ts",
    "./motion/tokens": "./src/motion/tokens.ts",
    "./three": "./src/three/index.ts",
    "./three/quality": "./src/three/quality.ts",
    "./three/capabilities": "./src/three/capabilities.ts",
    "./three/components": "./src/three/components/index.ts",
    "./catalog.json": "./catalog.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/rapier": "^2.2.0",
    "d3": "^7.9.2",
    "gsap": "^3.15.1",
    "motion": "^14.14.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.187.0"
