{
  "name": "maquettekit",
  "version": "4.0.0",
  "private": true,
  "description": "Maquettekit — Design Intelligence. Motion Engineering. Digital Experiences. A design, motion, interaction and 3D engineering plugin for Claude Code and OpenAI Codex.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=20.11" },
  "workspaces": ["apps/gallery", "plugins/maquettekit/library", "plugins/maquettekit/tools"],
  "scripts": {
    "dev": "npm run dev -w @maquettekit/gallery",
    "build": "npm run build -w @maquettekit/gallery",
    "start": "npm run start -w @maquettekit/gallery",
    "catalog": "node scripts/build-catalog.mjs",
    "typecheck": "npm run typecheck -w @maquettekit/library && npm run typecheck -w @maquettekit/tools && npm run typecheck -w @maquettekit/gallery",
    "test": "npm run test:unit && npm run test:plugin",
    "test:unit": "vitest run",
    "test:plugin": "node --test tests/plugin/*.test.mjs",
    "test:e2e": "playwright test --trace off",
    "validate": "node scripts/validate-plugin.mjs",
    "doctor": "node plugins/maquettekit/tools/maquettekit.mjs doctor",
    "release": "node scripts/package-release.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-react": "latest",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
